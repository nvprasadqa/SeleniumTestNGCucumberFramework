<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Selenium CrossBrowser Suite" verbose="1" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Cucumber BDD">
        <classes>
            <class name="bdd.runner.CucumberTestRunner"/>
        </classes>
    </test>
</suite>